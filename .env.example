# Local SQLite (default — keep using this while features are unfinished)
DATABASE_URL="file:./prisma/dev.db"

# Demo session signing secret (min 16 chars). Required in production (Railway).
SESSION_SECRET="payease-local-dev-session-secret"

# --- Supabase / Railway cutover (leave unset until go-live) ---------------
# After creating a Supabase project, set these on Railway and optionally locally:
#
# DATABASE_URL=postgresql://...@aws-0-....pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://...@aws-0-....supabase.com:5432/postgres
#
# DATABASE_URL = transaction pooler (app runtime)
# DIRECT_URL   = direct connection (prisma migrate deploy)
# See docs/DEPLOY.md
